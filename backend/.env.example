# ── Backend (.env) ────────────────────────────────────────────────────────────
# Copy to backend/.env for local development, or paste these into your host's
# environment variable settings (Railway / Render / Fly).

# Postgres connection string. Neon and Supabase both hand you one of these.
DATABASE_URL=postgresql://user:password@ep-xyz.neon.tech/neondb?sslmode=require

# Local Postgres instead? Point at it and TLS switches off automatically:
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/consultation_system

# Optional. Pooled connections held open, since reconnecting to a managed
# Postgres costs a TLS handshake every time. 0 disables pooling.
# DB_POOL_SIZE=3

# Optional. Overrides the sslmode in DATABASE_URL:
# disable | require (default for remote hosts) | verify-ca | verify-full
# DB_SSLMODE=require


# ── Security ──────────────────────────────────────────────────────────────────
# The app refuses to start if SECRET_KEY or the admin password still hold
# their built-in development defaults. That is deliberate: those
# values are in the source, so a deployment carrying one has no authentication
# at all. Set ALLOW_INSECURE_DEFAULTS=1 for local work only.

# Signs session tokens. Anyone who knows it can forge a session for any role.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string

# Which frontend origins may call this API. Comma-separated. Never "*".
ALLOWED_ORIGINS=https://your-app.vercel.app

# Administrator sign-in. Prefer the hash so the plaintext is never in the
# environment; ADMIN_PASSWORD is accepted and hashed at boot as a convenience.
#   python -c "import bcrypt; print(bcrypt.hashpw(b'YOUR-PASSWORD', bcrypt.gensalt()).decode())"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=$2b$12$replace-with-your-own-bcrypt-hash
# ADMIN_PASSWORD=

# How long a session token stays valid, in hours. Tokens are stateless and
# cannot be revoked individually, so this is the blast radius of a leaked one.
# SESSION_TTL_HOURS=12

# Largest accepted request body, in MB. Profile photos arrive as base64.
# MAX_CONTENT_MB=8

# Local development only. Allows the built-in defaults above.
# ALLOW_INSECURE_DEFAULTS=1


# ── Only needed while migrating off the old MySQL database ───────────────────
# MYSQL_URL=mysql://user:password@host:3306/consultation_system


# ── Frontend (Vercel → Settings → Environment Variables) ─────────────────────
# VITE_API_BASE=https://your-backend.onrender.com/api
# VITE_SOCKET_URL=https://your-backend.onrender.com
