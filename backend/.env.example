# ── Backend (.env) ────────────────────────────────────────────────────────────
# Copy to backend/.env for local development, or paste these into your host's
# environment variable settings (Railway / Render / Fly).

# Postgres connection string. Neon and Supabase both hand you one of these.
DATABASE_URL=postgresql://user:password@ep-xyz.neon.tech/neondb?sslmode=require

# Local Postgres instead? Point at it and TLS switches off automatically:
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/consultation_system

# Optional. Pooled connections held open, since reconnecting to a managed
# Postgres costs a TLS handshake every time. 0 disables pooling.
# DB_POOL_SIZE=3

# Optional. Overrides the sslmode in DATABASE_URL:
# disable | require (default for remote hosts) | verify-ca | verify-full
# DB_SSLMODE=require

SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_ORIGINS=https://your-app.vercel.app
KIOSK_PASSWORD=admin123
ADMIN_PASSWORD=admin123

# ── Only needed while migrating off the old MySQL database ───────────────────
# MYSQL_URL=mysql://user:password@host:3306/consultation_system


# ── Frontend (Vercel → Settings → Environment Variables) ─────────────────────
# VITE_API_BASE=https://your-backend.onrender.com/api
# VITE_SOCKET_URL=https://your-backend.onrender.com
