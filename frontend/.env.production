# Read by all three apps at build time (see envDir in shared/build/vite-app.js).
# A value set in Vercel (Settings -> Environment Variables) overrides this file
# per variable, so treat what's here as the fallback rather than the source of
# truth.

# The backend. The Socket.IO host is derived from this URL's origin, so there is
# no second variable to keep in step. Set VITE_SOCKET_URL only if the websocket
# really does live on a different host from the API.
VITE_API_BASE=https://urs-consultation.onrender.com/api

# Where the three apps are deployed.
#
# These are what the links between them are built from — the cards on the front
# page, the "in the wrong place?" row on every sign-in, and every answer Navi
# gives about a screen it does not itself serve. Unset, they fall back to the
# development ports, which on a deployed site means links to localhost.
#
# Fill these in once the three Vercel projects have their domains, or set them
# per project in Vercel. All three apps need all three values: each one links to
# the other two.
VITE_STUDENT_URL=
VITE_FACULTY_URL=
VITE_ADMIN_URL=
