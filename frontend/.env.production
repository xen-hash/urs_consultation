# Set this to your Render backend URL after deploying the backend.
# A value set in Vercel (Settings -> Environment Variables) overrides this file,
# so treat what's here as the fallback rather than the source of truth.
#
# The Socket.IO host is derived from this URL's origin, so there is no second
# variable to keep in step. Set VITE_SOCKET_URL only if the websocket really
# does live on a different host from the API.
VITE_API_BASE=https://urs-consultation.onrender.com/api
