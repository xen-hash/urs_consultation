# ── Vercel Environment Variables ──
# Add this in Vercel -> your project -> Settings -> Environment Variables.
# It overrides the committed .env.production.

# Your backend URL, including /api and with no trailing slash.
VITE_API_BASE=https://your-backend.onrender.com/api

# Optional. Socket.IO defaults to the origin of VITE_API_BASE; set this only if
# the websocket lives on a different host.
# VITE_SOCKET_URL=https://your-backend.onrender.com
